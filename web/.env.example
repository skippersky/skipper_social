# Base URL of the backend API.
# Leave empty (or remove) to call the same origin; nginx proxies /api to Spring Boot.
VITE_API_BASE=http://localhost:8080

# Stripe publishable key, test mode only.
# Checkout is backend-driven (Stripe Checkout Session URL); this key is reserved
# for future Stripe Elements usage and must never be a live key in this file.
VITE_STRIPE_PUBLIC_KEY=pk_test_REPLACE_ME
# Sprint 5b channel OAuth (Meta / TikTok apps).
# Used by the real OAuth flows once the backend integration is live;
# the offline demo loop does not require them.
VITE_META_APP_ID=REPLACE_ME
VITE_TIKTOK_CLIENT_KEY=REPLACE_ME